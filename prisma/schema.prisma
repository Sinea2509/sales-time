// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SystemRoleType {
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationMembershipRole {
  ADMIN
  MEMBER
}

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum SuperAdminInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum MeetingOutcome {
  WON
  LOST
  FOLLOW_UP
  NO_SHOW
  OTHER
}

enum AnalysisKind {
  SONCAS
  DISC
  KISS
  FOLLOW_UP_EMAIL
  MEETING_BRIEFING
  MEETING_DETAIL_SYNTHESIS
  SELLER_PERFORMANCE
  SELLER_AFFINITY
  ORG_KISS_ROLLUP
  TEAM_COACHING
}

enum OnboardingSharedPhraseKind {
  OBJECTION
  ARGUMENT
}

enum UserProfileRole {
  COMMERCIAL
  SALES_MANAGER
  LEADERSHIP
  OTHER
}

enum MeetingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum MeetingSourceType {
  UPLOAD
  TRANSCRIPT
}

enum AnalysisJobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
  DEAD
}

enum AiCallKind {
  DISC
  SONCAS
  COACHING
  PREPARE
  EMAIL
}

enum AiCallStatus {
  SUCCESS
  ERROR
}

enum PlanRequestStatus {
  NEW
  CONTACTED
  CONVERTED
  DISMISSED
}

enum FeedbackType {
  BUG
  IDEA
  QUESTION
  OTHER
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

enum FeedbackPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                           String    @id @default(cuid())
  email                        String    @unique
  passwordHash                 String
  /** Canonical hostname from signup (e.g. `example.com`); used when creating the first org. */
  signupWebsiteNormalized      String?
  firstName                    String?
  lastName                     String?
  /** Profile picture (Vercel Blob URL). */
  avatarUrl                    String? @db.Text
  profileRole                  UserProfileRole?
  registerProfileCompletedAt   DateTime?
  tamObjectiveMinutesPerMonth  Int?
  status                       UserStatus @default(ACTIVE)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  sessions                   Session[]
  passwordResetTokens        PasswordResetToken[]
  systemRoles                SystemRole[]
  auditLogsAsActor           SuperAdminAuditLog[]      @relation("AuditActor")
  onboardingProfile          OnboardingProfile?
  meetingsAsSeller           Meeting[]                 @relation("MeetingSeller")
  promptTemplateVersions     PromptTemplateVersion[]
  onboardingPhrasesCreated   OnboardingSharedPhrase[] @relation("OnboardingPhraseAuthor")
  organizationMemberships    OrganizationMembership[]
  invitationsSent            OrganizationInvitation[] @relation("InvitationInviter")
  invitationsAccepted        OrganizationInvitation[] @relation("InvitationAcceptor")
  superAdminInvitationsSent     SuperAdminInvitation[] @relation("SuperAdminInvitationInviter")
  superAdminInvitationsAccepted SuperAdminInvitation[] @relation("SuperAdminInvitationAcceptor")
  managerId                     String?
  manager                       User?                  @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  managedUsers                  User[]                 @relation("UserManager")
  notifications                 Notification[]
  feedbacks                     Feedback[]
  planRequestsSubmitted         PlanRequest[]          @relation("PlanRequestRequester")

  @@index([managerId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?  @db.VarChar(512)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  /** Stable hostname key for deduplication (matches `User.signupWebsiteNormalized`). */
  websiteNormalized String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings     OrganizationSettings?
  memberships  OrganizationMembership[]
  invitations  OrganizationInvitation[]
  trialAnalysesLeft Int @default(5)
  /** Set when a plan upgrade request is converted — unlimited analyses, no trial UI. */
  planUnlockedAt DateTime?

  people       Person[]
  meetings     Meeting[]
  analysisJobs AnalysisJob[]
  aiRequestLogs AiRequestLog[]
  planRequests PlanRequest[]
  feedbacks    Feedback[]
  notifications Notification[]
}

model OrganizationMembership {
  id             String                     @id @default(cuid())
  userId         String
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrganizationMembershipRole
  followUpEmailTone        String?
  followUpEmailVouvoiement Boolean?
  followUpEmailSignature   String? @db.Text
  createdAt      DateTime                   @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model OrganizationInvitation {
  id               String                       @id @default(cuid())
  organizationId   String
  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email            String                       @db.VarChar(320)
  role             OrganizationMembershipRole
  tokenHash        String                       @unique
  expiresAt        DateTime
  status           OrganizationInvitationStatus @default(PENDING)
  invitedByUserId  String
  invitedBy        User                         @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedByUserId String?
  acceptedBy       User?                        @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime                     @default(now())

  @@index([organizationId])
  @@index([email])
}

model SuperAdminInvitation {
  id               String                     @id @default(cuid())
  email            String                     @db.VarChar(320)
  tokenHash        String                     @unique
  expiresAt        DateTime
  status           SuperAdminInvitationStatus   @default(PENDING)
  invitedByUserId  String
  invitedBy        User                       @relation("SuperAdminInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedByUserId String?
  acceptedBy       User?                      @relation("SuperAdminInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime                   @default(now())

  @@index([email])
}

model OnboardingSharedPhrase {
  id              String                     @id @default(cuid())
  kind            OnboardingSharedPhraseKind
  text            String                     @db.VarChar(500)
  normalizedText  String                     @db.VarChar(500)
  createdByUserId String?
  createdBy       User?                      @relation("OnboardingPhraseAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime                   @default(now())

  @@unique([kind, normalizedText])
  @@index([kind, createdAt])
}

/// Org-scoped settings (editable from /company/settings).
model OrganizationSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyName           String?
  /** Public URL for the organization logo (e.g. Vercel Blob). */
  logoUrl               String? @db.Text
  industrySector        String?
  commercialTeamSize    String?
  averageSalesCycle     String?
  averageDealSize       String?

  companyPitch       String? @db.Text
  objections         Json?
  keyArguments       Json?
  industryVocabulary String? @db.Text
  /** Consignes optionnelles par quadrant KISS (global / manager / commercial), Coach IA. */
  kissCoachingPrompts Json?

  meetingTypes   Json?
  pipelineStages Json?

  emailTone        String?
  emailVouvoiement Boolean  @default(true)
  emailSignature   String? @db.Text

  tamCrMinutes                  Int @default(15)
  tamCrmMinutes                 Int @default(10)
  tamEmailMinutes               Int @default(8)
  tamResidualMinutes            Int @default(5)
  tamObjectiveMinutesPerMonth   Int @default(180)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OnboardingProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName           String?
  industrySector        String?
  commercialTeamSize    String?
  averageSalesCycle     String?
  averageDealSize       String?

  companyPitch       String? @db.Text
  objections         Json?
  keyArguments       Json?
  industryVocabulary String? @db.Text

  meetingTypes   Json?
  pipelineStages Json?

  /// Draft invites (wizard) until step 4 creates OrganizationInvitation rows.
  inviteEmails  Json?
  inviteMessage String? @db.Text

  currentStep Int       @default(1)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SystemRole {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      SystemRoleType
  createdAt DateTime       @default(now())

  @@unique([userId, role])
}

model SuperAdminAuditLog {
  id              String   @id @default(cuid())
  actorUserId     String
  actor           User     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  organizationId  String
  action          String
  reason          String?
  createdAt       DateTime @default(now())

  @@index([actorUserId])
  @@index([organizationId])
}

model Person {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  displayName    String
  normalizedKey  String
  company        String?
  email          String?
  phone          String?
  jobTitle       String?
  notes          String?      @db.Text
  discDominant   String?
  soncasDominant String?
  meetings       Meeting[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, normalizedKey])
  @@index([organizationId])
}

model Meeting {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sellerUserId   String
  seller         User           @relation("MeetingSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)
  personId       String
  person         Person         @relation(fields: [personId], references: [id], onDelete: Restrict)
  prospectName   String
  meetingAt      DateTime
  durationMin      Int?
  meetingType    String?
  pipelineStage  String?
  potentialAmount Float?
  followUpEmailDraft String?   @db.Text
  visitReportDraft   String?   @db.Text
  transcript     String         @db.Text
  notes          String?        @db.Text
  outcome        MeetingOutcome
  feeling        Int?
  status         MeetingStatus      @default(PENDING)
  errorMessage   String?            @db.Text
  sourceType     MeetingSourceType  @default(TRANSCRIPT)
  sourceBlobUrl  String?
  analyses       MeetingAnalysis[]
  analysisJobs   AnalysisJob[]
  aiRequestLogs  AiRequestLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
  @@index([sellerUserId])
  @@index([organizationId, sellerUserId])
  @@index([personId])
  @@index([status])
}

model MeetingAnalysis {
  id              String                @id @default(cuid())
  meetingId       String
  meeting         Meeting               @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  kind            AnalysisKind
  promptVersionId String
  promptVersion   PromptTemplateVersion @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)
  model           String
  result          Json
  rawText         String?               @db.Text
  createdAt       DateTime              @default(now())

  @@index([meetingId, kind])
}

model PromptTemplate {
  id               String                 @id @default(cuid())
  kind             AnalysisKind           @unique
  /// Vercel AI Gateway model id (`provider/model`) for this prompt kind.
  model            String                 @default("openai/gpt-4o-mini")
  currentVersionId String?                @unique
  currentVersion   PromptTemplateVersion? @relation("PromptTemplateCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         PromptTemplateVersion[] @relation("PromptTemplateVersions")
}

model PromptTemplateVersion {
  id           String           @id @default(cuid())
  templateId   String
  template     PromptTemplate   @relation("PromptTemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  markdown     String           @db.Text
  version      Int
  authorUserId String
  author       User             @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  createdAt    DateTime         @default(now())
  currentOf    PromptTemplate?  @relation("PromptTemplateCurrentVersion")
  analyses     MeetingAnalysis[]

  @@unique([templateId, version])
}

/// Singleton (id = `default`) : consignes KISS par quadrant, éditées en super admin.
model GlobalKissCoachingPrompts {
  id        String   @id
  prompts   Json?
  updatedAt DateTime @updatedAt
}

model AnalysisJob {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meetingId      String
  meeting        Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  jobType        String            @default("analyze_meeting")
  status         AnalysisJobStatus @default(QUEUED)
  priority       Int               @default(0)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(3)
  runAfter       DateTime          @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  aiRequestLogs  AiRequestLog[]

  @@index([status, runAfter, priority])
  @@index([meetingId])
}

model AiRequestLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  meetingId      String?
  meeting        Meeting?      @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  jobId          String?
  job            AnalysisJob?  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  kind           AiCallKind
  status         AiCallStatus
  modelName      String
  promptVersion  String        @default("1")
  systemPrompt   String?       @db.Text
  userPrompt     String?       @db.Text
  rawOutput      Json?
  errorMessage   String?       @db.Text
  inputTokens    Int?
  outputTokens   Int?
  latencyMs      Int?
  temperature    Float?
  createdAt      DateTime      @default(now())

  @@index([meetingId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model PlanRequest {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedById  String?
  requestedBy    User?             @relation("PlanRequestRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  desiredPlan    String?
  message        String?           @db.Text
  status         PlanRequestStatus @default(NEW)
  handledAt      DateTime?
  createdAt      DateTime          @default(now())

  @@index([status, createdAt])
  @@index([organizationId])
}

model Feedback {
  id             String         @id @default(cuid())
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail      String?
  companyName    String?
  type           FeedbackType     @default(BUG)
  message        String           @db.Text
  status         FeedbackStatus   @default(NEW)
  priority       FeedbackPriority @default(MEDIUM)
  screenshotUrl  String?
  pageUrl        String?
  userAgent      String?        @db.Text
  browser        String?
  os             String?
  deviceType     String?
  viewport       String?
  screenSize     String?
  locale         String?
  appVersion     String?
  consoleErrors  Json?
  extra          Json?
  adminNotes     String?        @db.Text
  handledAt      DateTime?
  createdAt      DateTime       @default(now())

  @@index([status, createdAt])
  @@index([priority, createdAt])
  @@index([organizationId])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  body           String       @db.Text
  href           String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId, readAt, createdAt])
  @@index([organizationId])
}
