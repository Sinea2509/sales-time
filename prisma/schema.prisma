// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SystemRoleType {
  SUPER_ADMIN
}

enum MeetingOutcome {
  WON
  LOST
  FOLLOW_UP
  NO_SHOW
  OTHER
}

enum AnalysisKind {
  SONCAS
  DISC
}

enum OnboardingSharedPhraseKind {
  OBJECTION
  ARGUMENT
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  systemRoles              SystemRole[]
  auditLogsAsActor         SuperAdminAuditLog[]      @relation("AuditActor")
  onboardingProfile        OnboardingProfile?
  meetingsAsSeller         Meeting[]                 @relation("MeetingSeller")
  promptTemplateVersions   PromptTemplateVersion[]
  onboardingPhrasesCreated OnboardingSharedPhrase[] @relation("OnboardingPhraseAuthor")
}

/// Phrases d’objections / arguments partagées entre tous les utilisateurs (onboarding Coach IA).
model OnboardingSharedPhrase {
  id              String                     @id @default(cuid())
  kind            OnboardingSharedPhraseKind
  text            String                     @db.VarChar(500)
  normalizedText  String                     @db.VarChar(500)
  createdByUserId String?
  createdBy       User?                      @relation("OnboardingPhraseAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime                   @default(now())

  @@unique([kind, normalizedText])
  @@index([kind, createdAt])
}

/// Admin onboarding wizard (design: Onboarding admin.pdf) — post–Clerk sign-up.
/// Configuration partagée au niveau de l’organisation (Clerk org id).
/// Éditable par les org admins depuis /dashboard/settings.
model OrganizationSettings {
  id         String @id @default(cuid())
  clerkOrgId String @unique

  // Contexte (aligné sur l’onboarding admin)
  companyName           String?
  industrySector        String?
  commercialTeamSize    String?
  averageSalesCycle     String?
  averageDealSize       String?

  // Coach IA
  companyPitch       String? @db.Text
  objections         Json?
  keyArguments       Json?
  industryVocabulary String? @db.Text

  // Process
  meetingTypes   Json?
  pipelineStages Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OnboardingProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Étape 1 — Contexte
  companyName           String?
  industrySector        String?
  commercialTeamSize    String?
  averageSalesCycle     String?
  averageDealSize       String?

  // Étape 2 — Coach IA
  companyPitch         String? @db.Text
  objections           Json?
  keyArguments         Json?
  industryVocabulary   String? @db.Text

  // Étape 3 — Process
  meetingTypes    Json?
  pipelineStages  Json?

  // Étape 4 — Invitations
  inviteEmails   Json?
  inviteMessage  String? @db.Text

  currentStep Int       @default(1)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SystemRole {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      SystemRoleType
  createdAt DateTime       @default(now())

  @@unique([userId, role])
}

model SuperAdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  clerkOrgId  String
  action      String
  reason      String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([clerkOrgId])
}

/// Canonical contact per organization (deduped by normalized display key).
model Person {
  id            String    @id @default(cuid())
  clerkOrgId    String
  displayName   String
  normalizedKey String
  meetings      Meeting[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([clerkOrgId, normalizedKey])
  @@index([clerkOrgId])
}

model Meeting {
  id           String         @id @default(cuid())
  clerkOrgId   String
  sellerUserId String
  seller       User           @relation("MeetingSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)
  personId     String
  person       Person         @relation(fields: [personId], references: [id], onDelete: Restrict)
  prospectName String
  meetingAt    DateTime
  durationMin  Int?
  transcript   String         @db.Text
  notes        String?        @db.Text
  outcome      MeetingOutcome
  analyses     MeetingAnalysis[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([clerkOrgId])
  @@index([sellerUserId])
  @@index([clerkOrgId, sellerUserId])
  @@index([personId])
}

model MeetingAnalysis {
  id              String                @id @default(cuid())
  meetingId       String
  meeting         Meeting               @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  kind            AnalysisKind
  promptVersionId String
  promptVersion   PromptTemplateVersion @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)
  model           String
  result          Json
  rawText         String?               @db.Text
  createdAt       DateTime              @default(now())

  @@index([meetingId, kind])
}

model PromptTemplate {
  id               String                 @id @default(cuid())
  kind             AnalysisKind           @unique
  currentVersionId String?                @unique
  currentVersion   PromptTemplateVersion? @relation("PromptTemplateCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         PromptTemplateVersion[] @relation("PromptTemplateVersions")
}

model PromptTemplateVersion {
  id           String           @id @default(cuid())
  templateId   String
  template     PromptTemplate   @relation("PromptTemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  markdown     String           @db.Text
  version      Int
  authorUserId String
  author       User             @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  createdAt    DateTime         @default(now())
  currentOf    PromptTemplate?  @relation("PromptTemplateCurrentVersion")
  analyses     MeetingAnalysis[]

  @@unique([templateId, version])
}
