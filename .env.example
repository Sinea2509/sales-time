# Database — Neon on Vercel: pooled URL for the app, direct URL for Prisma CLI (migrate/seed).
# https://neon.com/docs/guides/prisma
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Vercel Neon integration also provides DATABASE_URL_UNPOOLED (same role as DIRECT_URL for Prisma CLI).
# Local Postgres (set DIRECT_URL only if you use Neon-style split; otherwise DATABASE_URL alone is enough):
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sales_time?schema=public"

# Super-admin elevation cookie (HMAC). Required in production.
# SUPER_ADMIN_ORG_COOKIE_SECRET="..."

# Transactional email (optional in dev — logs to console without key)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Sales Time <onboarding@yourdomain.com>"
APP_BASE_URL="http://localhost:3000"

# If NODE_ENV=production but the app is served over HTTP (e.g. `next start` on LAN),
# browsers ignore Secure cookies unless you set:
# ALLOW_INSECURE_SESSION_COOKIES=1

# Vercel AI Gateway — https://vercel.com/docs/ai-gateway (SONCAS / DISC analysis)
# AI_GATEWAY_API_KEY="..."

# Seed: creates user + SUPER_ADMIN + prompt templates (`npx prisma db seed`)
# Defaults: stephane@mytradeshow.ai / MyTradeshow2026!SuperAdmin (override below)
# SEED_SUPER_ADMIN_EMAIL="stephane@mytradeshow.ai"
# SEED_SUPER_ADMIN_PASSWORD="MyTradeshow2026!SuperAdmin"
# Dev only — reset password for existing seed user: SEED_SUPER_ADMIN_RESET_PASSWORD=1
