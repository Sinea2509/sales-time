# Production secrets: copy `.env.production.example` → `.env.production`, then
# `npm run sync:vercel-env` (local) or GitHub Actions. See docs/env-sync.md.
#
# Database · Neon on Vercel: pooled URL for the app, direct URL for Prisma CLI (migrate/seed).
# https://neon.com/docs/guides/prisma
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Vercel Neon integration also provides DATABASE_URL_UNPOOLED (same role as DIRECT_URL for Prisma CLI).
# Local Postgres (set DIRECT_URL only if you use Neon-style split; otherwise DATABASE_URL alone is enough):
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sales_time?schema=public"

# Prisma: set PRISMA_LOG_QUERIES=1 in development to print every SQL (`prisma:query`); off by default.
# PRISMA_LOG_QUERIES=1

# Super-admin elevation cookie (HMAC). Required in production.
# SUPER_ADMIN_ORG_COOKIE_SECRET="..."

# Transactional email (optional in dev, logs to console without key)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Sales Time <onboarding@yourdomain.com>"
APP_BASE_URL="http://localhost:3000"

# Vercel Blob: org logos, feedback screenshots, meeting transcripts
# https://vercel.com/docs/storage/vercel-blob
# BLOB_STORE_ID="store_..."
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# If NODE_ENV=production but the app is served over HTTP (e.g. `next start` on LAN),
# browsers ignore Secure cookies unless you set:
# ALLOW_INSECURE_SESSION_COOKIES=1

# Vercel Cron RGPD purge (Authorization: Bearer <secret>)
# CRON_SECRET="..."
# NEXT_PUBLIC_COMMIT_SHA="local-dev"
# Force re-login on release: set to a new value, or rely on NEXT_PUBLIC_COMMIT_SHA / VERCEL_GIT_COMMIT_SHA.
# AUTH_SESSION_VERSION="2026-06-19"

# Optional: notify super admin on plan upgrade requests
# SUPERADMIN_EMAILS="admin@example.com"
# AI_GATEWAY_API_KEY="..."

# Seed: SUPER_ADMIN + demo org Acme Solutions (`npm run db:seed`)
# Super admin defaults: stephane@mytradeshow.ai / MyTradeshow2026!SuperAdmin
# SEED_SUPER_ADMIN_EMAIL="stephane@mytradeshow.ai"
# SEED_SUPER_ADMIN_PASSWORD="MyTradeshow2026!SuperAdmin"
# SEED_SUPER_ADMIN_RESET_PASSWORD=1
#
# Demo org (manager + 3 sales, contacts, RDV avec analyses SONCAS/DISC/KISS):
# SEED_DEMO_ORG_SLUG="acme-demo"
# SEED_DEMO_ORG_NAME="Acme Solutions"
# SEED_DEMO_PASSWORD="DemoOrg2026!"
# SEED_DEMO_RESET=1          # wipe & reseed contacts/RDV
# SEED_DEMO_RESET_PASSWORD=1 # reset demo user passwords
# Sign-in: manager@acme-demo.local (admin), sophie/lucas/emma @acme-demo.local (sales)
