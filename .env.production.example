# Production env · copy to `.env.production` (gitignored), fill values, then:
#   npm run sync:vercel-env
# See docs/env-sync.md. GitHub Actions uses the same keys as repository secrets.

# --- Vercel sync credentials (local script only; not pushed to Vercel) ---
# Optional when logged in via `vercel login`: token is read from the CLI auth file.
# VERCEL_TOKEN=""
# Auto-filled from `.vercel/` after `vercel link` when org/project IDs are unset.
# VERCEL_ORG_ID=""
# VERCEL_PROJECT_ID=""
# Optional: Vercel → Project → Settings → Git → Deploy Hooks (Production)
# VERCEL_DEPLOY_HOOK_URL=""

# --- Synced to Vercel (see .github/vercel-env.manifest.json), all required ---
DATABASE_URL=""
DIRECT_URL=""
CRON_SECRET=""
AI_GATEWAY_API_KEY=""
SUPER_ADMIN_ORG_COOKIE_SECRET=""
APP_BASE_URL="https://sales-time-mytradeshowai.vercel.app"
RESEND_API_KEY=""
EMAIL_FROM="Sales Time <onboarding@yourdomain.com>"
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
SUPERADMIN_EMAILS="admin@example.com"
AUTH_SESSION_VERSION="2026-06-19"
